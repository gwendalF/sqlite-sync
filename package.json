{
  "name": "@gwendalf/sync-sqlite",
  "version": "0.1.3",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "test": "vitest -p unit",
    "browser": "vitest -p browser",
    "test-all": "vitest",
    "dev": "vite",
    "build-wasm": "wasm-pack build ./rust --target web --out-dir ../src/sync_sqlite --out-name sync_sqlite && pnpm vitest --clearCache",
    "build": "rm -rf dist && pnpm build-wasm && tsc -p ./tsconfig.build.json && cp -r src/sync_sqlite dist/ && rm dist/sync_sqlite/.gitignore",
    "test:e2e": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gwendalF/sqlite-sync.git"
  },
  "homepage": "https://github.com/gwendalF/sqlite-sync#readme",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.3",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.4",
    "@vitest/browser-playwright": "^5.0.5",
    "http-server": "^14.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.5"
  }
}
