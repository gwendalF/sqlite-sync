{
  "name": "sync-sqlite",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest -p unit",
    "test-all": "vitest",
    "dev": "vite",
    "build-wasm": "wasm-pack build ./rust --target web --out-dir ../src/sync_sqlite --out-name sync_sqlite && pnpm vitest --clearCache",
    "build": "pnpm build-wasm && tsc -p ./tsconfig.build.json && cp -r src/sync_sqlite dist/ && rm dist/sync_sqlite/.gitignore",
    "test:browser": "vitest --config=vitest.browser.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.3",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/browser-playwright": "^5.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.5"
  }
}
